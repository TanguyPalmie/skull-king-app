{
  "name": "taggy",
  "private": true,
  "scripts": {
    "dev": "docker compose -f docker/docker-compose.dev.yml up --build",
    "prod": "docker compose -f docker/docker-compose.prod.yml up --build -d",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "test:docker": "docker compose -f docker/docker-compose.test.yml up --build --abort-on-container-exit",
    "lint": "pnpm -r lint",
    "migrate": "pnpm --filter api migrate",
    "seed": "pnpm --filter api seed"
  },
  "engines": {
    "node": ">=20"
  }
}
